{
  "info": {
    "name": "Assignment2 - TODO3 and TODO5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Direct service tests through TODO5. Gateway routing is TODO7."
  },
  "variable": [
    {
      "key": "accountUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "brandUrl",
      "value": "http://localhost:8082"
    }
