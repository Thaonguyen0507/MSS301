      "item": [
        {
          "name": "01 admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{accountUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"adminsys\",\n  \"password\": \"@1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Correct role\", function () { pm.expect(pm.response.json().data.role).to.eql(1); });",
                  "const authTokens = pm.response.json().data; pm.collectionVariables.set('accessToken', authTokens.accessToken); pm.collectionVariables.set('refreshToken', authTokens.refreshToken);",
                  "pm.test(\"Access JWT claims\", function () { const p=JSON.parse(atob(authTokens.accessToken.split('.')[1])); pm.expect(p.sub).to.eql('1'); pm.expect(p.role).to.eql(1); pm.expect(p.type).to.eql('access'); pm.expect(p.exp-p.iat).to.eql(900); });",
                  "pm.test(\"Refresh JWT claims\", function () { const p=JSON.parse(atob(authTokens.refreshToken.split('.')[1])); pm.expect(p.type).to.eql('refresh'); pm.expect(p.exp-p.iat).to.eql(604800); });"
                ]
              }
            }
          ]
        },
